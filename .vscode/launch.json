{
    "version": "0.2.0",
    "configurations": [
       
        {
            "name": "Debug Maze",
            "type": "cppdbg",
            "request": "launch",
            // Path to the executable CMake built
            "program": "build/labirynth",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
